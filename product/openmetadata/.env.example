# Copy to .env; generate each value, never reuse one from elsewhere.
# openssl rand -hex 16 — applied only when the admin user is first created.
OM_ADMIN_PASSWORD=
# openssl rand -base64 32 — encrypts stored connection secrets; changing it breaks them.
OM_FERNET_KEY=
# Shared jury login (catalog/users.json), printed in the deck and README; applied only when the user is first created.
# OM's policy: 8+ characters with upper and lower case, a digit and a special character.
OM_JURY_PASSWORD=
