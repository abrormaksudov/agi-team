{
  "kind": "databaseService",
  "owner": "digital_banking",
  "service": {
    "name": "mobile",
    "serviceType": "Postgres",
    "description": "In-house mobile banking backend, one schema per microservice: app users and logins, devices, KYC.",
    "connection": {
      "config": {
        "type": "Postgres",
        "username": "openmetadata",
        "authType": { "password": "openmetadata" },
        "hostPort": "mobile:5432",
        "database": "mobile"
      }
    }
  },
  "pipelines": [
    {
      "name": "mobile_metadata",
      "pipelineType": "metadata",
      "stage": 1,
      "schedule": "0 5 * * *",
      "sourceConfig": {
        "type": "DatabaseMetadata",
        "includeViews": true,
        "includeTags": true,
        "includeDDL": true,
        "schemaFilterPattern": { "includes": [ "^users$", "^devices$", "^kyc$" ] }
      }
    },
    {
      "name": "mobile_usage",
      "pipelineType": "usage",
      "stage": 3,
      "schedule": "30 5 * * *",
      "sourceConfig": {
        "type": "DatabaseUsage",
        "queryLogDuration": 1,
        "resultLimit": 1000
      }
    },
    {
      "name": "mobile_profiler",
      "pipelineType": "profiler",
      "stage": 4,
      "schedule": "15 6 * * *",
      "sourceConfig": {
        "type": "Profiler",
        "schemaFilterPattern": { "includes": [ "^users$", "^devices$", "^kyc$" ] },
        "computeTableMetrics": true,
        "computeColumnMetrics": true,
        "threadCount": 2,
        "timeoutSeconds": 3600
      }
    }
  ]
}
